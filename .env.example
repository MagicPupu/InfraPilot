# Ollama runs on the host by default. From a container use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434

# Chat model. Approximate memory at Q4 with num_ctx=8192:
#   qwen3:8b    ~6-8 GB VRAM/RAM  (default, best quality)
#   llama3.1:8b ~6-8 GB
#   qwen3:4b    ~3-4 GB           (smaller fallback)
#   qwen3:1.7b  ~1.5-2 GB         (plumbing / fast dev loop)
LLM_MODEL=qwen3:8b
EMBED_MODEL=nomic-embed-text
NUM_CTX=8192

# Optional LLM-judge for eval answer quality. Leave empty to disable.
JUDGE_MODEL=
